    "sources": [
      {
        "citation": "Bessembinder, Hendrik (2018). 'Do Stocks Outperform Treasury Bills?' Journal of Financial Economics, 129(3), 440-457. Data updated through 2023 (CRSP database 1926-2023, 26,000+ US common stocks).",
        "tier": "TIER_1_ACADEMIC_PEER_REVIEWED"
      },
      {
        "citation": "Cembalest, Michael (2014, 2021). 'The Agony & The Ecstasy: The Risks and Rewards of a Concentrated Stock Position.' J.P. Morgan Asset Management (Russell 3000 constituent universe 1980-2020).",
        "tier": "TIER_2_INSTITUTIONAL_RESEARCH"
      },
      {
        "citation": "S&P Dow Jones Indices (2024). 'S&P 500 and S&P Composite 1500 Historical Constituent Return Distributions (1990-2024).'",
        "tier": "TIER_2_FINANCIAL_AGGREGATOR"
      }
    ]
  },
