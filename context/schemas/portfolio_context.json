{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortfolioContextCollection",
  "description": "Normalized, account-isolated portfolio states emitted by scripts/parse_snapshot.py. Null means the brokerage source did not provide enough information; it never means zero.",
  "type": "array",
  "items": { "$ref": "#/definitions/PortfolioContext" },
  "definitions": {
    "NullableNumber": { "type": ["number", "null"] },
    "PortfolioContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_status", "experimental_warning", "data_snapshot_id", "data_as_of",
        "model_version", "prompt_version", "evidence_percentages", "missing_inputs",
        "stale_inputs", "anomalous_inputs", "account_name", "account_type", "as_of_date",
        "total_account_value", "settled_cash",
        "long_stock_value", "long_option_value", "short_option_value",
        "sgov_shares", "sgov_market_value", "total_dry_powder",
        "dry_powder_percentage", "active_positions_count",
        "total_securities_count", "total_option_market_value", "positions",
        "open_options", "pending_orders", "external_flows", "reconciliation"
      ],
      "properties": {
        "experiment_status": { "const": "EXPERIMENTAL" },
        "experimental_warning": { "type": "string", "minLength": 40 },
        "data_snapshot_id": { "type": "string", "minLength": 8 },
        "data_as_of": { "type": ["string", "null"] },
        "model_version": { "type": "string" },
        "prompt_version": { "type": "string" },
        "evidence_percentages": { "type": "object" },
        "missing_inputs": { "type": "array", "items": { "type": "string" } },
        "stale_inputs": { "type": "array", "items": { "type": "string" } },
        "anomalous_inputs": { "type": "array", "items": { "type": "string" } },
        "account_name": { "type": "string", "minLength": 1 },
        "account_type": { "type": ["string", "null"] },
        "as_of_date": { "type": ["string", "null"], "format": "date" },
        "total_account_value": { "$ref": "#/definitions/NullableNumber" },
        "settled_cash": { "$ref": "#/definitions/NullableNumber" },
        "long_stock_value": { "$ref": "#/definitions/NullableNumber" },
        "long_option_value": { "$ref": "#/definitions/NullableNumber" },
        "short_option_value": { "$ref": "#/definitions/NullableNumber" },
        "sgov_shares": { "type": "number", "minimum": 0 },
        "sgov_market_value": { "$ref": "#/definitions/NullableNumber" },
        "total_dry_powder": { "$ref": "#/definitions/NullableNumber" },
        "dry_powder_percentage": { "$ref": "#/definitions/NullableNumber" },
        "active_positions_count": { "type": "integer", "minimum": 0 },
        "total_securities_count": { "type": "integer", "minimum": 0 },
        "total_option_market_value": { "$ref": "#/definitions/NullableNumber" },
        "positions": {
          "type": "array",
          "items": { "$ref": "#/definitions/Holding" }
        },
        "open_options": {
          "type": "array",
          "items": { "$ref": "#/definitions/OptionPosition" }
        },
        "pending_orders": { "type": "array" },
        "external_flows": { "type": "array" },
        "reconciliation": { "$ref": "#/definitions/Reconciliation" }
      }
    },
    "Holding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol", "shares", "mark_price", "market_value",
        "cost_basis_per_share", "cc_eligible_blocks", "cc_eligible"
      ],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
        "shares": { "type": "number", "minimum": 0 },
        "mark_price": { "$ref": "#/definitions/NullableNumber" },
        "market_value": { "$ref": "#/definitions/NullableNumber" },
        "cost_basis_per_share": { "$ref": "#/definitions/NullableNumber" },
        "cc_eligible_blocks": { "type": "integer", "minimum": 0 },
        "cc_eligible": { "type": "boolean" }
      }
    },
    "OptionPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol", "underlying", "option_type", "strike", "expiration", "contracts",
        "side", "multiplier", "mark_price", "market_value", "cost_per_contract",
        "premium_per_share", "collateral_required", "contract_validated"
      ],
      "properties": {
        "symbol": { "type": "string" },
        "underlying": { "type": ["string", "null"] },
        "option_type": { "type": ["string", "null"], "enum": ["PUT", "CALL", null] },
        "strike": { "$ref": "#/definitions/NullableNumber" },
        "expiration": { "type": ["string", "null"], "format": "date" },
        "contracts": { "type": "integer" },
        "side": { "type": "string", "enum": ["SHORT", "LONG"] },
        "multiplier": { "type": "integer", "const": 100 },
        "mark_price": { "$ref": "#/definitions/NullableNumber" },
        "market_value": { "$ref": "#/definitions/NullableNumber" },
        "cost_per_contract": { "$ref": "#/definitions/NullableNumber" },
        "premium_per_share": { "$ref": "#/definitions/NullableNumber" },
        "collateral_required": { "$ref": "#/definitions/NullableNumber" },
        "contract_validated": { "type": "boolean" }
      }
    },
    "Reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "authoritative_source", "authoritative_total_account_value",
        "computed_total_account_value", "difference_usd", "balance_changes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "RECONCILED", "AUTHORITATIVE_TOTAL_WITH_UNRESOLVED_COMPONENTS",
            "AUTHORITATIVE_TOTAL_MISMATCH", "COMPUTED_FROM_COMPLETE_COMPONENTS",
            "INCOMPLETE"
          ]
        },
        "authoritative_source": {
          "type": ["string", "null"],
          "enum": ["brokerage_balance", "positions_total", null]
        },
        "authoritative_total_account_value": { "$ref": "#/definitions/NullableNumber" },
        "computed_total_account_value": { "$ref": "#/definitions/NullableNumber" },
        "difference_usd": { "$ref": "#/definitions/NullableNumber" },
        "balance_changes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/NullableNumber" }
        }
      }
    }
  }
}
